iews":[{"review_id":"G05-W02-R1","source_id":"G05-S02-01","url":"https://nazolog.com/blog-entry-2512.html","accessed_at_utc":"2026-10-11T03:10:50Z","method":"web_reader","scope":"対象本文を結末まで照合。コメント・関連記事は除外。","provenance":"v1_ledger","identity_basis":"本文の題名・登場人物と既存台帳の内容を照合。"}],"investigation":[{"checked_at_utc":"2026-10-11T03:10:50Z","method":"web_reader","url":"https://nazolog.com/blog-entry-2512.html","query":"","outcome":"body_confirmed","note":"対象本文を結末まで照合。コメント・関連記事は除外。"}],"identity_recheck":null}
